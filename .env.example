# ---------- Backend ----------
# Comma-separated key pool, at least 2 keys. Ids are key_1, key_2, ... in this order.
LLM_API_KEYS=your-first-api-key,your-second-api-key
# LiteLLM model name. One value for all keys, or comma-separated to pair a model
# with each key (key_1 -> first model, key_2 -> second, the last one repeats).
LLM_MODEL=gemini/gemini-3.5-flash
# SQLite file location (inside the Docker volume mounted at /data).
DATABASE_URL=sqlite:////data/app.db
# Comma-separated CORS origins: the deployed frontend URL plus local dev.
ALLOWED_ORIGINS=http://localhost:3000
# true enables the X-Simulate-Failure test hook.
ENABLE_FAILURE_SIMULATION=true

# Optional
DEFAULT_SYSTEM_PROMPT=You are a helpful, concise assistant.
CACHE_ENABLED=true
# local = in-memory LiteLLM cache, disk = LiteLLM disk cache under CACHE_DIR
CACHE_TYPE=local
CACHE_DIR=/data/llm_cache
CACHE_TTL_SECONDS=3600
LLM_TIMEOUT_SECONDS=30
MAX_HISTORY_MESSAGES=40
LLM_MAX_OUTPUT_TOKENS=

# ---------- Frontend ----------
# Docker: backend URL as seen by the browser (written to config.js at startup).
FRONTEND_API_BASE_URL=http://localhost:8000
# Vercel/Netlify/npm run dev: backend URL baked in at build time.
VITE_API_BASE_URL=http://localhost:8000
